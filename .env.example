NODE_ENV=development
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h
CORS_ORIGIN=http://localhost:4000
DB_PATH=./data/portal.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
ATTENDANCE_MIN=75
TIMEZONE=Asia/Kolkata

# Used by `npm run seed:admin`
ADMIN_ID=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Portal Admin

# AI assistant. Groq is used when GROQ_API_KEY is set (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# AI_PROVIDER=groq            # or gemini
# AI_CONTEXT_CHARS=12000      # lower this if you hit Groq token-per-minute limits

# Optional fallback provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
